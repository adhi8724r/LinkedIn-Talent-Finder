# PostgreSQL connection string
postgres_url=postgresql://<DB_USERNAME>:<DB_PASSWORD>@localhost:5433/resume_db

# Qdrant Vector DB host
qdrant_host=http://localhost:6333

# JWT secret key for recruiter session authentication
SECRET_KEY=your_secret_key_here

# Groq API key for Meta Llama 3.3 70B candidate semantic evaluation
api=your_groq_api_key_here

